@inherits LayoutComponentBase

<div class="page">
    <AuthorizeView>
        <div class="sidebar">
            <NavMenu />
        </div>
    </AuthorizeView>

    <main>
        <AuthorizeView>
            <div class="top-row px-4">
                <span class="me-3 text-muted">@context.User.Identity?.Name（@(context.User.IsInRole("Owner") ? "店長" : "老師")）</span>
                <form method="post" action="logout" class="d-inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-link p-0">登出</button>
                </form>
            </div>
        </AuthorizeView>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    發生未預期的錯誤。
    <a href="." class="reload">重新載入</a>
    <span class="dismiss">🗙</span>
</div>
