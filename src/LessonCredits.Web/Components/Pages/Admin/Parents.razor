@page "/parents"
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@inherits AppPage
@inject AdminService AdminService

<PageTitle>家長</PageTitle>

<h1 class="h3 mb-3">家長與學生</h1>

<Alerts Error="@Error" Message="@Message" />

<div class="card mb-4">
    <div class="card-body d-flex gap-2 flex-wrap">
        <input class="form-control w-auto" placeholder="家長姓名" @bind="newParentName" />
        <input class="form-control w-auto" placeholder="電話" @bind="newParentPhone" />
        <button class="btn btn-primary" @onclick="AddParentAsync">新增家長</button>
    </div>
</div>

@if (parents is not null)
{
    <table class="table align-middle">
        <thead><tr><th>家長</th><th>電話</th><th>學生</th><th style="width:22rem">新增學生</th></tr></thead>
        <tbody>
            @foreach (var p in parents)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Phone</td>
                    <td>
                        @foreach (var s in p.Students)
                        {
                            <a class="badge bg-light text-dark border me-1 text-decoration-none" href="students/@s.Id">@s.Name</a>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <input class="form-control form-control-sm" placeholder="學生姓名" @bind="newStudentNames[p.Id]" />
                            <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="() => AddStudentAsync(p.Id)">新增</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="small text-muted">點數屬於學生個人，兄弟姊妹之間不可轉移。</p>
}

@code {
    private List<Parent>? parents;
    private string newParentName = "";
    private string newParentPhone = "";
    private Dictionary<int, string> newStudentNames = [];

    protected override async Task LoadAsync()
    {
        parents = await AdminService.ListParentsAsync(Actor);
        newStudentNames = parents.ToDictionary(p => p.Id, _ => "");
    }

    private async Task AddParentAsync()
    {
        if (await RunAsync(() => AdminService.AddParentAsync(newParentName, newParentPhone, Actor), $"已新增家長 {newParentName}。"))
        {
            newParentName = newParentPhone = "";
            await LoadAsync();
        }
    }

    private async Task AddStudentAsync(int parentId)
    {
        var name = newStudentNames[parentId];
        if (await RunAsync(() => AdminService.AddStudentAsync(parentId, name, Actor), $"已新增學生 {name}。"))
        {
            await LoadAsync();
        }
    }
}
