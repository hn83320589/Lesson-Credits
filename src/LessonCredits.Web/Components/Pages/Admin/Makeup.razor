@page "/makeup"
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@inherits AppPage
@inject MakeupService MakeupService

<PageTitle>補課預約</PageTitle>

<h1 class="h3 mb-3">補課預約</h1>
<p class="text-muted small">補課資格自產生日起 60 天內有效，只能預約同科目、仍有空位的小班場次（每班上限 @Course.GroupCapacity 人）。</p>

<Alerts Error="@Error" Message="@Message" />

<table class="table align-middle">
    <thead><tr><th>學生</th><th>科目</th><th>產生日</th><th>有效至</th><th>狀態</th><th>預約</th></tr></thead>
    <tbody>
        @foreach (var c in credits)
        {
            <tr class="@(selected?.Id == c.Id ? "table-primary" : "")">
                <td><a href="students/@c.StudentId">@c.StudentName</a></td>
                <td>@c.Subject.Label()</td>
                <td>@Fmt.Date(c.IssuedOn)</td>
                <td class="@(c.IsExpired ? "text-danger" : "")">@Fmt.Date(c.ExpiresOn)</td>
                <td>@(c.IsExpired ? "已逾期" : c.Status.Label())</td>
                <td>
                    @if (c.Status == MakeupStatus.Booked && c.BookingId is { } bookingId)
                    {
                        <span class="small">@c.BookedCourseName @Fmt.DateTime(c.BookedSessionStartAt!.Value)</span>
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => CancelAsync(bookingId)">取消預約</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectAsync(c)">選擇場次</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (selected is not null)
{
    <div class="card">
        <div class="card-body">
            <h2 class="h6">為 @selected.StudentName 預約 @selected.Subject.Label() 補課（有效至 @Fmt.Date(selected.ExpiresOn)）</h2>
            @if (options.Count == 0)
            {
                <p class="text-muted mb-0">目前沒有符合條件的場次。</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>時間</th><th>課程</th><th>老師</th><th>目前人數</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in options)
                        {
                            <tr>
                                <td>@Fmt.DateTime(s.StartAt)</td>
                                <td>@s.CourseName</td>
                                <td>@s.TeacherName</td>
                                <td>@s.SeatsTaken / @Course.GroupCapacity</td>
                                <td class="text-end"><button class="btn btn-sm btn-primary" @onclick="() => BookAsync(s)">預約</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<MakeupCreditView> credits = [];
    private MakeupCreditView? selected;
    private List<BookableSession> options = [];

    protected override async Task LoadAsync() => credits = await MakeupService.ListCreditsAsync(openOnly: true);

    private async Task SelectAsync(MakeupCreditView credit)
    {
        selected = credit;
        options = credit.IsExpired ? [] : await MakeupService.FindBookableSessionsAsync(credit.Id);
        if (credit.IsExpired)
        {
            Error = $"此補課資格已於 {Fmt.Date(credit.ExpiresOn)} 逾期，無法使用。";
        }
    }

    private async Task BookAsync(BookableSession session)
    {
        if (await RunAsync(() => MakeupService.BookAsync(selected!.Id, session.SessionId, Actor), $"已為 {selected!.StudentName} 預約 {session.CourseName} {Fmt.DateTime(session.StartAt)}。"))
        {
            selected = null;
            await LoadAsync();
        }
    }

    private async Task CancelAsync(int bookingId)
    {
        if (await RunAsync(() => MakeupService.CancelBookingAsync(bookingId, Actor), "已取消預約，補課資格恢復可使用。"))
        {
            await LoadAsync();
        }
    }
}
